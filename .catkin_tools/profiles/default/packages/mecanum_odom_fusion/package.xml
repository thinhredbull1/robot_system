<?xml version="1.0"?>
<package format="2">
  <name>mecanum_odom_fusion</name>
  <version>0.1.0</version>
  <description>Custom C++ EKF fusing mecanum wheel odometry with rf2o laser odometry.</description>
  <maintainer email="todo@todo.com">maintainer</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>rospy</exec_depend>
</package>
